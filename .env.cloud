# ============================================================
# EdAgent 云端环境配置（个人 VPS + 云端 LLM API）
# 用法：docker compose --env-file .env.cloud \
#         -f docker-compose.yml -f docker-compose.cloud.yml up -d
# ⚠️ 本文件含密钥，请勿提交/外发（.gitignore 已覆盖 .env*）
# ============================================================

# ---------- 宿主机端口映射 ----------
# nginx 对公网暴露 80；配好域名+证书后再加 443（见交付说明）
NGINX_HOST_PORT=80
# 以下端口均绑定 127.0.0.1 不对外，保持默认即可
CHROMA_HOST_PORT=18000
POSTGRES_HOST_PORT=15432
REDIS_HOST_PORT=16379
AGENT_API_PORT=18080
# 可观测组件默认不启动，端口无需关心
OTEL_GRPC_HOST_PORT=14317
OTEL_HTTP_HOST_PORT=14318
JAEGER_UI_HOST_PORT=16686
PROMETHEUS_HOST_PORT=19090
GRAFANA_HOST_PORT=13000

# ---------- 密码 / 密钥（务必全部换成新生成的随机值！不要沿用本地的）----------
# 生成方法（PowerShell）：
#   -join ((48..57)+(97..122) | Get-Random -Count 24 | % {[char]$_})
PG_PASSWORD=CHANGE_ME_生成24位随机串
AGENT_API_KEY=edagent-sk-CHANGE_ME_生成32位随机hex
AGENT_SESSION_SECRET=CHANGE_ME_生成32位随机串
GRAFANA_PASSWORD=CHANGE_ME_仅启用observability时才用得到

# ---------- 注册开关 ----------
# 保持 false：不对外开放注册，账号由你手动创建/管理
# ⚠️ 云端首次部署不用改这里：库中无用户时仍会放行，请立刻注册你自己的管理员账号；
#    注册完第一个账号后，该入口自动失效。
# 如需临时开放注册，改成 true 后重启 agent-api
AGENT_ALLOW_REGISTER=false

# ---------- LLM（云端 API，默认 DeepSeek 示例）----------
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-CHANGE_ME_填你的DeepSeek_Key
LLM_MODEL=deepseek-chat
# 备选：
#   - deepseek-reasoner（R1 推理版，更慢更贵，适合复杂任务）
#   - 通义千问 https://dashscope.aliyuncs.com/compatible-mode/v1 （qwen-plus 等）
#   - 硅基流动 https://api.siliconflow.cn/v1 （一个 key 同时提供 LLM + embedding，见下）

# ---------- Embedding（云端 API）----------
# ⚠️ 换 embedding 模型 = 向量维度变化 = 旧知识库向量全部失效，
#    首次云端启动后需重新导入文档（compose 已自动换新 collection 名）
# 推荐硅基流动（有免费额度，中文效果好，OpenAI 兼容）：
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=sk-CHANGE_ME_填你的SiliconFlow_Key
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
# 备选 OpenAI：EMBEDDING_BASE_URL=https://api.openai.com/v1
#               EMBEDDING_MODEL=text-embedding-3-small
# 简化方案：LLM 也改用硅基流动（Qwen2.5 / DeepSeek 系列它都有），一个 key 通吃

# ---------- 推理参数（云端 API 快，超时从 CPU 的 900s 回调）----------
LLM_TIMEOUT=120
LLM_MAX_RETRIES=2

# Team OS：在线 API 无本地排队问题，可并发执行
TEAM_MAX_PARALLEL=3
