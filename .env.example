# ============================================================
# EdAgent 本地 AI Agent 环境变量示例
# 复制为 .env 并修改密码；.env 不要提交到 Git
# ============================================================

# ---------- 宿主机端口映射（已避让本机占用端口：80/443/6379/11434/3326/5193/8020/6399）----------
OLLAMA_HOST_PORT=11534
CHROMA_HOST_PORT=18000
POSTGRES_HOST_PORT=15432
REDIS_HOST_PORT=16379
AGENT_API_PORT=18080
NGINX_HOST_PORT=18088
OTEL_GRPC_HOST_PORT=14317
OTEL_HTTP_HOST_PORT=14318
JAEGER_UI_HOST_PORT=16686
PROMETHEUS_HOST_PORT=19090
GRAFANA_HOST_PORT=13000

# ---------- 密码 / 密钥（生产环境务必全部更换）----------
PG_PASSWORD=change_me
AGENT_API_KEY=change_me
# Web 登录会话 Cookie 签名密钥，可用 python -c "import secrets;print(secrets.token_hex(32))" 生成
AGENT_SESSION_SECRET=change_me
GRAFANA_PASSWORD=change_me

# ---------- 注册开关 ----------
# true=开放注册；false=关闭（仅管理员可在管理后台开通账号）
# 注意：库中尚无任何用户时始终放行，用于引导首个 admin（云端首次部署必需）
AGENT_ALLOW_REGISTER=true

# ---------- LLM（默认：项目独立的容器内 Ollama）----------
LLM_BASE_URL=http://ollama:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=deepseek-r1:8b
# 工具调用更稳定的备选模型：qwen2.5:7b

# ---------- Embedding（默认：本地 Ollama）----------
EMBEDDING_BASE_URL=http://ollama:11434/v1
EMBEDDING_API_KEY=ollama
EMBEDDING_MODEL=nomic-embed-text

# 在线 API 切换示例（DeepSeek）：
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=sk-xxx
# LLM_MODEL=deepseek-chat

# 在线 Embedding 示例（OpenAI）：
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=sk-xxx
# EMBEDDING_MODEL=text-embedding-3-small

# ---------- CPU 推理参数 ----------
OLLAMA_NUM_THREADS=8

# LLM 调用超时/重试（CPU 下 R1 8B 单次生成可达 5 分钟+，180s 默认必超时；CPU 建议 300-600）
LLM_TIMEOUT=180
LLM_MAX_RETRIES=2

# Team OS：并发调度（CPU 单槽推理建议 1，避免排队超时；在线 API 可 3-4）
TEAM_MAX_PARALLEL=2

# ---------- 多 Agent 协作（可选）----------
# 审稿者最多退回修订的轮数（超出后无条件放行）
AGENT_TEAM_MAX_ROUNDS=2
# 规划者提示词（留空使用默认值）
# AGENT_TEAM_PLANNER_PROMPT=
# 审稿者提示词（留空使用默认值；{iteration} 和 {max_rounds} 为占位符）
# AGENT_TEAM_REVIEWER_PROMPT=

# ---------- RAG 检索调优 ----------
# 检索策略：mmr（默认，多样性去重）/ similarity（纯相似度）/ similarity_score_threshold（带分数过滤）
# AGENT_RAG_SEARCH_TYPE=mmr
# MMR 多样性参数（0.0-1.0，越小越多样，仅 mmr 生效）
# AGENT_RAG_MMR_LAMBDA_MULT=0.5
# 相似度分数阈值（0.0-1.0，仅 similarity_score_threshold 生效）
# AGENT_RAG_SCORE_THRESHOLD=0.0
# 返回文档数量
# AGENT_RAG_TOP_K=5
